<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Template for Pippa.app/Contents/Info.plist. scripts/build-app.sh replaces
  __VERSION__ (Pippa.version from PippaCore.swift), __BUILD__ (commit count)
  and __YEAR__.
  Visible texts here are English (development language, fallback). Translations:
  app/Packaging/Localization/{en,de}.lproj/InfoPlist.strings (key = Info.plist key;
  for CFBundleTypeName the English name) and ServicesMenu.strings (key = English
  Services menu title). build-app.sh copies them to Contents/Resources/<language>.lproj.
-->
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleLocalizations</key>
	<array>
		<string>en</string>
		<string>de</string>
	</array>
	<key>CFBundleAllowMixedLocalizations</key>
	<true/>
	<key>CFBundleExecutable</key>
	<string>Pippa</string>
	<key>CFBundleIdentifier</key>
	<string>io.github.tschnorpfeil.pippa</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>Pippa</string>
	<key>CFBundleDisplayName</key>
	<string>Pippa</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>__VERSION__</string>
	<key>CFBundleVersion</key>
	<string>__BUILD__</string>
	<key>CFBundleIconFile</key>
	<string>AppIcon</string>
	<key>CFBundleSupportedPlatforms</key>
	<array>
		<string>MacOSX</string>
	</array>
	<key>LSMinimumSystemVersion</key>
	<string>15.0</string>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.productivity</string>
	<key>LSUIElement</key>
	<true/>
	<key>NSPrincipalClass</key>
	<string>NSApplication</string>
	<key>NSHighResolutionCapable</key>
	<true/>
	<key>NSSupportsAutomaticTermination</key>
	<false/>
	<key>NSHumanReadableCopyright</key>
	<string>© __YEAR__ Tobias Schnorpfeil.</string>

	<!-- Texts of the system prompts (macOS asks only when the feature is used).
	     Calendar and Reminders: add deadlines and remove them again (undo), hence full access.
	     Apple Events: read the selected mail and the active Excel sheet; nothing is sent without approval.
	     Folders (Desktop, Documents, Downloads): without the App Sandbox, macOS asks on first access. -->
	<key>NSCalendarsFullAccessUsageDescription</key>
	<string>When you ask, Pippa reads your appointments for the period you ask about, and adds deadlines from your letters to Calendar, which it can remove again.</string>
	<key>NSRemindersFullAccessUsageDescription</key>
	<string>Pippa adds deadlines from your letters to Reminders when you ask, and can remove them again.</string>
	<key>NSAppleEventsUsageDescription</key>
	<string>Pippa reads the email you selected in Mail and the table you’re looking at in Excel, and searches Photos for the pictures you ask about. Nothing is sent without your approval.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>When you ask for pictures, Pippa shows the matching photos from your library. She doesn’t change or upload anything.</string>
	<key>NSDesktopFolderUsageDescription</key>
	<string>Pippa reads and tidies files on your Desktop when you ask her to. You can undo her changes.</string>
	<key>NSDocumentsFolderUsageDescription</key>
	<string>Pippa reads and tidies files in your Documents folder when you ask her to. You can undo her changes.</string>
	<key>NSDownloadsFolderUsageDescription</key>
	<string>Pippa reads and tidies files in your Downloads folder when you ask her to. You can undo her changes.</string>

	<!-- Automatic updates (Sparkle 2, see docs/development.md "Releasing").
	     Check daily, download silently and install on the next quit; no "Check for updates automatically?"
	     dialog because the values are already set here.
	     SUPublicEDKey: public EdDSA key; the private one lives only in the developer's keychain
	     (generate_keys) and signs every update.
	     Without the App Sandbox, Sparkle installs directly: no SUEnableInstallerLauncherService,
	     no SUEnableDownloaderService; build-app.sh removes Sparkle's XPC services from the bundle
	     (Sparkle docs, "Sandboxing": not sandboxed means the XPC services are not needed and may be removed). -->
	<key>SUFeedURL</key>
	<string>https://github.com/tschnorpfeil/pippa/releases/latest/download/appcast.xml</string>
	<key>SUPublicEDKey</key>
	<string>BM/Djr2FKjYH9JN70SGI8LxeGtSnwB1yfDPPOPl5syw=</string>
	<key>SUEnableAutomaticChecks</key>
	<true/>
	<key>SUAutomaticallyUpdate</key>
	<true/>
	<key>SUAllowsAutomaticUpdates</key>
	<true/>
	<key>SUScheduledCheckInterval</key>
	<integer>86400</integer>
	<key>SUVerifyUpdateBeforeExtraction</key>
	<true/>

	<!-- Drag files and folders onto the Dock or app icon. -->
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>File or Folder</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>public.item</string>
			</array>
		</dict>
	</array>

	<!-- Services menu: "Look at with Pippa" / "Mit Pippa ansehen" (ServicesMenu.strings) for files and selected text.
	     The app must set NSApp.servicesProvider and
	     implement pippaService(_:userData:error:). -->
	<key>NSServices</key>
	<array>
		<dict>
			<key>NSMenuItem</key>
			<dict>
				<key>default</key>
				<string>Look at with Pippa</string>
			</dict>
			<key>NSMessage</key>
			<string>pippaService</string>
			<key>NSPortName</key>
			<string>Pippa</string>
			<key>NSRequiredContext</key>
			<dict/>
			<key>NSSendFileTypes</key>
			<array>
				<string>public.item</string>
			</array>
			<key>NSSendTypes</key>
			<array>
				<string>NSStringPboardType</string>
				<string>public.utf8-plain-text</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
