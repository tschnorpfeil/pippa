"NSCalendarsFullAccessUsageDescription" = "When you ask, Pippa reads your appointments for the period you ask about, and adds deadlines from your letters to Calendar, which it can remove again.";
"NSRemindersFullAccessUsageDescription" = "Pippa adds deadlines from your letters to Reminders when you ask, and can remove them again.";
"NSAppleEventsUsageDescription" = "When you ask, Pippa reads the email you selected in Mail and the table you’re looking at in Excel, and searches your photos and notes. Nothing is sent without your approval.";
"NSPhotoLibraryUsageDescription" = "When you ask for pictures, Pippa shows the matching photos from your library. She doesn’t change or upload anything.";
"NSDesktopFolderUsageDescription" = "Pippa reads and tidies files on your Desktop when you ask her to. You can undo her changes.";
"NSDocumentsFolderUsageDescription" = "Pippa reads and tidies files in your Documents folder when you ask her to. You can undo her changes.";
"NSDownloadsFolderUsageDescription" = "Pippa reads and tidies files in your Downloads folder when you ask her to. You can undo her changes.";
"NSRemovableVolumesUsageDescription" = "Pippa reads and tidies files on your USB sticks and external disks when you ask her to. You can undo her changes.";
"NSFileProviderDomainUsageDescription" = "Pippa reads and tidies files in your iCloud Drive when you ask her to. You can undo her changes.";
"NSContactsUsageDescription" = "When you ask, Pippa looks up addresses and phone numbers in your contacts. She doesn’t change them.";
