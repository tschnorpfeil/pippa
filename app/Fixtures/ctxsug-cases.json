  "sequences": [
    { "id": "seq-late-after-choice", "expect": "Spätes Modellergebnis nach Klick auf ein Regelangebot ändert die Angebote nicht und startet nichts." },
    { "id": "seq-late-after-switch", "expect": "Dokument A entfernt, B gegeben, bevor A klassifiziert ist: As Rolle landet nie bei B." },
    { "id": "seq-late-after-add", "expect": "Zweites Dokument ergänzt, bevor A klassifiziert ist: Angebot für beide, As Rolle verworfen." },
    { "id": "seq-typing", "expect": "Tippen vor dem Modellergebnis friert die Angebote ein." },
    { "id": "seq-deadline", "expect": "Klassifikation über 4 s wird verworfen, Regelangebot bleibt." },
    { "id": "seq-timely", "expect": "Rechtzeitiges Modellergebnis ersetzt die Angebote an derselben Stelle." },
    { "id": "ctx-switch-unrelated", "expect": "A geben, fragen; B auf die Pille geben, fragen: neues Thema, Engine sieht nur B." },
    { "id": "ctx-add-related", "expect": "Im offenen Gespräch C ergänzen: gleiches Thema, Engine sieht B und C, Fokus C." },
    { "id": "ctx-remove-readd", "expect": "C entfernen: Engine sieht nur B, neue Modellsitzung; erneutes Ablegen von C bringt es ins selbe Thema zurück." },
    { "id": "ctx-busy-give", "expect": "Während eine Antwort läuft, landet eine neue Gabe auf der Ablage, nicht im laufenden Thema; Aktionen, die das Gespräch brauchen, sind erkennbar nicht verfügbar statt stumm." },
    { "id": "ctx-stop-switch", "expect": "Stoppen, dann neues Thema: späte Rückrufe landen weder im alten noch im neuen Thema als fertige Antwort." },
    { "id": "ctx-reopen", "expect": "Wiederöffnen < 10 min zeigt dasselbe Gespräch; > 10 min kompakte Eingabe mit Thema; Neues Thema startet frisch ohne alte Quellen." },
    { "id": "ctx-back-to-previous", "expect": "Nach automatischem Themenwechsel bringt „Zurück zum vorigen Gespräch“ die neue Datei ins alte Thema, ohne verlorene Quellen." }
  ]
