+        verify(chat.current?.messages.count == 4, "Gespräch mit vier Nachrichten")
+        await shot("website-01-gespraech")
+
+        // 2. Calendar from the real calendar route, with the follow-ups under the newest answer.
+        let demo = stub.integrations
+        demo.set(.calendar, .granted)
+        demo.calendarEvents = [
+            CalendarEvent(id: "w-markt", title: "Wochenmarkt mit Lena", start: at(0, 10), end: at(0, 11), calendar: "Privat", color: "#34C759"),
+            CalendarEvent(id: "w-rad", title: "Fahrrad zur Inspektion bringen", start: at(0, 17, 30), end: at(0, 18), calendar: "Privat", color: "#34C759"),
+            CalendarEvent(id: "w-oma", title: "Geburtstag Oma Hilde", start: at(0, 19), end: at(0, 22), calendar: "Familie", color: "#FF9500"),
+            CalendarEvent(id: "w-lauf", title: "Laufen im Stadtwald", start: at(1, 9), end: at(1, 10), calendar: "Privat", color: "#34C759"),
+            CalendarEvent(id: "w-zahn", title: "Zahnarzt Dr. Brandt", start: at(2, 8, 30), end: at(2, 9, 15), calendar: "Privat", color: "#34C759"),
+            CalendarEvent(id: "w-team", title: "Teambesprechung", start: at(2, 10), end: at(2, 11), calendar: "Arbeit", color: "#1BADF8"),
+        ]
+        func ask(_ text: String) async {
+            model.route(text)
+            for _ in 0..<200 {
+                if !model.isActiveWork { break }
+                try? await Task.sleep(for: .milliseconds(50))
