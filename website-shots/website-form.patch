+        }
+        await fresh()
+        await ask("Was steht heute in meinem Kalender?")
+        let todayRead = chat.current?.messages.last?.calendar
+        verify(todayRead?.state == .read && todayRead?.card != nil, "Kalender heute gelesen, als Karte")
+        if let todayRead { lines.append("     Nachfragen heute: " + CalendarConversation.followUps(for: todayRead, now: now, calendar: calendar).joined(separator: " · ")) }
+        await shot("website-02-kalender-heute")
+        await fresh()
+        await ask("Was steht diese Woche noch an?")
+        if let weekRead = chat.current?.messages.last?.calendar {
+            lines.append("     Nachfragen Woche (\(weekRead.range.kind)): " + CalendarConversation.followUps(for: weekRead, now: now, calendar: calendar).joined(separator: " · "))
