+        await fresh()
+        chat.appendForSnapshot(ConversationMessage(role: .user, text: "Wann kommt mein neuer Fahrradhelm?", timestamp: at(0, 15, 41)))
+        chat.appendForSnapshot(ConversationMessage(role: .assistant, text: "Laut der Versandmail von Radhaus Lindner kommt er am Montag zwischen 10 und 14 Uhr.",
+                                                   timestamp: at(0, 15, 41)))
+        chat.appendForSnapshot(ConversationMessage(role: .user, text: "Wie lange ist meine Kündigungsfrist? Merk dir bitte, dass ich Ende März ausziehen will.",
+                                                   timestamp: at(0, 16, 5), attachments: [lease], topicStart: true))
+        let answer = """
