+        chat.appendForSnapshot(ConversationMessage(role: .user, text: "Was kostet eine Fahrradinspektion in Köln ungefähr?"))
+        chat.appendForSnapshot(ConversationMessage(role: .assistant, text: "Meist **zwischen 50 und 90 Euro** für eine Standardinspektion, Ersatzteile kommen dazu. Bei E-Bikes eher 80 bis 130 Euro.",
+                                                   actions: ActionReceipt(items: [.init(action: "webSearch", outcome: "done", name: query)], cards: web.map { [.web($0)] }),
+                                                   ))
+        await shot("website-07-online")
+
+        // 7. Found on this Mac (real files in the capture folder).
+        await fresh()
+        let found = ["Rechnung Fahrradhelm.pdf", "Garantie Fahrrad Lindner.pdf", "Inspektion 2025.pdf", "Rahmennummer Fahrrad.jpg"].map { files.appendingPathComponent($0) }
+        for file in found where file.pathExtension == "pdf" {
+            writePDF(to: file, title: file.deletingPathExtension().lastPathComponent, lines: ["Beispieldokument für die Website.", "Radhaus Lindner · Köln"])
+        }
+        if let jpg = found.last { writeJPEG(to: jpg) }
+        chat.appendForSnapshot(ConversationMessage(role: .user, text: "Wo ist die Rechnung für meinen Fahrradhelm?"))
+        chat.appendForSnapshot(ConversationMessage(role: .assistant, text: "Gefunden: „Rechnung Fahrradhelm.pdf“ in deinen Beispieldateien. Dazu passen noch drei weitere Dateien zum Fahrrad.",
+                                                   attachments: found))
+        await shot("website-08-gefunden")
+
+        try? (["website"] + lines).joined(separator: "\n").appending("\n").write(to: directory.appendingPathComponent("website.txt"), atomically: true, encoding: .utf8)
+    }
+
+    private static func writePDF(to url: URL, title: String, lines: [String]) {
+        var box = CGRect(x: 0, y: 0, width: 595, height: 842)
+        guard let context = CGContext(url as CFURL, mediaBox: &box, nil) else { return }
+        context.beginPDFPage(nil)
+        NSGraphicsContext.saveGraphicsState()
+        NSGraphicsContext.current = NSGraphicsContext(cgContext: context, flipped: false)
+        (title as NSString).draw(at: NSPoint(x: 60, y: 760), withAttributes: [.font: NSFont.boldSystemFont(ofSize: 22)])
+        for (index, line) in lines.enumerated() {
+            (line as NSString).draw(at: NSPoint(x: 60, y: 710 - CGFloat(index) * 24), withAttributes: [.font: NSFont.systemFont(ofSize: 12)])
+        }
+        NSGraphicsContext.restoreGraphicsState()
+        context.endPDFPage()
+        context.closePDF()
+    }
+
+    private static func writeJPEG(to url: URL) {
+        let image = NSImage(size: NSSize(width: 400, height: 300), flipped: false) { rect in
+            NSColor(calibratedWhite: 0.92, alpha: 1).setFill(); rect.fill()
+            ("WBK 4021 7Z" as NSString).draw(at: NSPoint(x: 110, y: 140), withAttributes: [.font: NSFont.monospacedSystemFont(ofSize: 28, weight: .bold)])
+            return true
+        }
+        guard let tiff = image.tiffRepresentation, let rep = NSBitmapImageRep(data: tiff),
+              let data = rep.representation(using: .jpeg, properties: [.compressionFactor: 0.8]) else { return }
+        try? data.write(to: url)
+    }
+
+    /// Only Pippa's window, cropped to the shell (as CalendarSnapshot); fallback draws the view hierarchy.
+    private static func capture(_ shell: ShellController, to destination: URL) -> Bool {
+        let window = shell.panel
+        let temporary = destination.deletingLastPathComponent().appendingPathComponent("website-window-\(UUID().uuidString).png")
+        defer { try? FileManager.default.removeItem(at: temporary) }
+        let process = Process()
+        process.executableURL = URL(fileURLWithPath: "/usr/sbin/screencapture")
+        process.arguments = ["-x", "-o", "-l", "\(window.windowNumber)", temporary.path]
+        var data: Data?
+        do { try process.run(); process.waitUntilExit(); data = try? Data(contentsOf: temporary) } catch {}
+        if data == nil, let view = window.contentView, let rep = view.bitmapImageRepForCachingDisplay(in: view.bounds) {
+            view.cacheDisplay(in: view.bounds, to: rep)
+            data = rep.representation(using: .png, properties: [:])
+        }
+        guard let data, let rep = NSBitmapImageRep(data: data), let image = rep.cgImage else { return false }
+        let region = shell.shellScreenRect.insetBy(dx: -30, dy: -30)
+            .offsetBy(dx: -window.frame.minX, dy: -window.frame.minY)
+            .intersection(CGRect(origin: .zero, size: window.frame.size))
+        let scale = CGFloat(image.width) / window.frame.width
+        let pixels = CGRect(x: region.minX * scale, y: (window.frame.height - region.maxY) * scale,
+                            width: region.width * scale, height: region.height * scale).integral
+        guard let cropped = image.cropping(to: pixels),
+              let png = NSBitmapImageRep(cgImage: cropped).representation(using: .png, properties: [:]) else { return false }
+        do { try png.write(to: destination, options: .atomic); return true } catch { return false }
+    }
+}
+#endif
