+        // 3. Mail.
+        await fresh()
+        let mails = [
+            MailHeader(subject: "Dein Fahrradhelm ist unterwegs", sender: "Radhaus Lindner <versand@radhaus-lindner.example>", date: at(0, 9, 12),
+                       mailbox: "Eingang", preview: "Hallo Mara, deine Bestellung 40215 hat unser Lager verlassen. Voraussichtliche Zustellung: Montag zwischen 10 und 14 Uhr."),
+            MailHeader(subject: "Termin Inspektion bestätigt", sender: "Radhaus Lindner <werkstatt@radhaus-lindner.example>", date: at(-2, 14, 30),
+                       mailbox: "Eingang", preview: "Wir haben deinen Termin für heute, 17:30 Uhr, eingetragen. Bitte bring den Schlüssel für das Rahmenschloss mit."),
+            MailHeader(subject: "Rechnung zu deiner Bestellung", sender: "Radhaus Lindner <rechnung@radhaus-lindner.example>", date: at(-5, 11, 3),
+                       mailbox: "Eingang", preview: "Im Anhang findest du die Rechnung über 79,90 Euro für den Helm „City Pro“, Größe M."),
+        ]
+        chat.appendForSnapshot(ConversationMessage(role: .user, text: "Hat mir der Fahrradladen geschrieben?"))
+        chat.appendForSnapshot(ConversationMessage(role: .assistant, text: "Ja, drei Mails von Radhaus Lindner. Die neueste: Dein Helm kommt am Montag zwischen 10 und 14 Uhr.",
+                                                   actions: ActionReceipt(items: [.init(action: "read", outcome: "done", name: L("Searched Mail for “%@”: %lld found", table: "MCP", "Radhaus Lindner", 3))], cards: [.mail(MailCard(query: "Radhaus Lindner", mails: mails, total: 3, calendar: calendar))])))
+        await shot("website-04-mail")
+
+        // 4. Photos (stock tiles only from PIPPA_WEBSITE_PHOTOS).
+        await fresh()
+        let day = DateFormatter()
+        day.locale = calendar.locale ?? .autoupdatingCurrent
+        day.setLocalizedDateFormatFromTemplate("EEEdMMMyyyy")
+        let photoDays = [-1, -1, -9, -23, -40, -61]
+        let photos = photoDays.enumerated().map { index, offset in
+            let date = at(offset, 11 + index)
+            return PhotoCard.Item(id: "bike\(index + 1)", date: date, dateLabel: day.string(from: date), label: "Fahrrad \(index + 1)")
+        }
+        let photoCard = PhotoCard(query: "Fahrrad", items: photos, total: photos.count, previews: true,
+                                  footer: L("Photos on this Mac · %lld found", table: "MCP", photos.count), truncatedNote: nil)
+        chat.appendForSnapshot(ConversationMessage(role: .user, text: "Zeig mir meine Fotos vom Fahrrad."))
+        chat.appendForSnapshot(ConversationMessage(role: .assistant, text: "Ich habe sechs Fotos mit Fahrrädern gefunden. Ein Klick öffnet das Foto in Fotos.",
+                                                   actions: ActionReceipt(items: [.init(action: "read", outcome: "done", name: L("Searched Photos for “%@”: %lld found", table: "MCP", "Fahrrad", photos.count))], cards: [.photos(photoCard)])))
+        await shot("website-05-fotos")
+
+        // 5. Reminders, one overdue.
+        await fresh()
+        let reminders = [
+            ReminderItem(title: "Reifen aufpumpen", list: "Fahrrad", due: at(-1, 18), dueHasTime: true),
+            ReminderItem(title: "Fahrrad zur Inspektion bringen", list: "Fahrrad", due: at(0, 17, 30), dueHasTime: true),
+            ReminderItem(title: "Geschenk für Oma Hilde abholen", list: "Privat", due: at(0, 0)),
+            ReminderItem(title: "Kündigung Mietvertrag abschicken", list: "Privat", due: at(3, 0)),
+        ]
+        chat.appendForSnapshot(ConversationMessage(role: .user, text: "Was muss ich diese Woche noch erledigen?"))
+        chat.appendForSnapshot(ConversationMessage(role: .assistant, text: "Vier Erinnerungen sind offen. „Reifen aufpumpen“ war schon gestern fällig.",
+                                                   actions: ActionReceipt(items: [.init(action: "read", outcome: "done", name: L("Read Reminders: due in the next %lld days", table: "MCP", 7))], cards: [.reminders(ReminderCard(days: 7, reminders: reminders, total: 4, now: now, calendar: calendar))])))
+        verify(ReminderCard(days: 7, reminders: reminders, total: 4, now: now, calendar: calendar).items.first?.overdue == true, "Eine Erinnerung überfällig")
+        await shot("website-06-erinnerungen")
+
+        // 6. Online looked up.
+        await fresh()
+        let query = "Fahrradinspektion Kosten Köln"
+        let web = WebSourcesCard(queries: [query],
+                                 pagesRead: ["https://www.radratgeber.example/inspektion/kosten", "https://www.fahrradwerkstatt-koeln.example/preise"],
+                                 searchResults: ["[ADFC Tipps](https://www.radclub.example/wartung/inspektion) https://www.stadtrad-magazin.example/ratgeber/inspektion-checkliste"],
